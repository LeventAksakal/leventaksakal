---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" description="This page does not exist.">
  <main class="wrap">
    <h1 class="display">Not found</h1>
    <p>There is no page at this address. <a href="/">Back to the start</a>.</p>
  </main>
</Base>

<style>
  main { padding-top: clamp(56px, 10vw, 140px); min-height: 70svh; }
  h1 { font-size: clamp(2.2rem, 1.5rem + 2.6vw, 3.6rem); margin-bottom: 24px; }
  p { color: var(--soft); }
  a { color: var(--accent); }
</style>
