---
// One column of the shelf: a plain list, cover on the left, each row a link to the work itself.
// Rows are as tall as what they hold, so the three columns end where they end.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Item { slug: string; title: string; line: string; note?: string; href: string }
interface Props { title: string; count: string; goes: string; items: Item[]; square?: boolean }
const { title, count, goes, items, square = false } = Astro.props;
const covers = import.meta.glob<{ default: ImageMetadata }>('../assets/covers/*.jpg', { eager: true });
const cover = (slug: string) => covers[`../assets/covers/${slug}.jpg`]?.default;
const shown = items.filter((i) => cover(i.slug));
const FIRST = 7; // rows a phone shows before "Show all"
---
<section class:list={['col', { square }]} data-shelf>
  <header>
    <h3>{title}</h3>
    <p>{count} · {goes}</p>
  </header>
  <ol>
    {shown.map((i, n) => (
      <li class:list={{ late: n >= FIRST }}>
        <a href={i.href} rel="noopener">
          <span class="art">
            <Image src={cover(i.slug)} alt="" width={square ? 64 : 56} height={square ? 64 : 84} densities={[1, 2, 3]} fit="cover" quality={80} loading="lazy" />
          </span>
          <span class="text">
            <span class="t">{i.title}</span>
            <span class="m">{i.line}</span>
            {i.note && <span class="n">“{i.note}”</span>}
          </span>
          <svg class="go" viewBox="0 0 14 14" aria-hidden="true"><path d="M3.5 10.5 10.5 3.5M5 3.5h5.5V9" /></svg>
        </a>
      </li>
    ))}
  </ol>
  {shown.length > FIRST && <button class="all" type="button" data-all aria-expanded="false">Show all {shown.length}</button>}
</section>

<style>
  /* Two fixed lines, neither may wrap: the three lists must start at the same height. */
  header { padding-bottom: 14px; border-bottom: 1px solid color-mix(in srgb, var(--text) 34%, var(--bg)); }
  h3 { font-stretch: 108%; font-weight: 620; font-size: 1.3rem; letter-spacing: -.02em; line-height: 1.15; }
  h3, header p { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  header p { margin-top: 3px; font-size: .9rem; line-height: 1.3; color: var(--dim); }

  li { border-bottom: 1px solid var(--rule); }
  a { --w: 56px; display: grid; grid-template-columns: var(--w) minmax(0, 1fr) 14px; align-items: center; gap: 16px; padding: 11px 6px 11px 0; text-decoration: none; transition: background-color .25s ease, padding .35s var(--ease); }
  .square a { --w: 64px; }
  a:hover { background: color-mix(in srgb, var(--accent) 7%, transparent); padding-left: 8px; color: var(--text); }

  .art { display: block; width: var(--w); border-radius: 2px; overflow: hidden; background: var(--raise); box-shadow: 0 8px 16px -10px rgb(0 0 0 / .9), inset 0 0 0 1px rgb(255 255 255 / .06); transition: transform .45s var(--ease); }
  .art :global(img) { width: 100%; height: auto; aspect-ratio: 2 / 3; object-fit: cover; }
  .square .art :global(img) { aspect-ratio: 1; }
  a:hover .art { transform: scale(1.06) rotate(-1.5deg); }

  .text { display: grid; gap: 2px; min-width: 0; }
  .t { font-weight: 600; font-size: 1rem; line-height: 1.25; letter-spacing: -.008em; text-wrap: pretty; }
  .m { font-size: .89rem; line-height: 1.3; color: var(--dim); font-variant-numeric: tabular-nums; }
  .n { margin-top: 3px; font-size: .9rem; line-height: 1.32; color: var(--sub); }

  .go { width: 13px; height: 13px; fill: none; stroke: var(--accent); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; opacity: 0; transform: translate(-4px, 4px); transition: opacity .25s ease, transform .35s var(--ease); }
  a:hover .go, a:focus-visible .go { opacity: 1; transform: none; }

  .all { display: none; }
  @media (max-width: 860px) {
    .col:not([data-open]) .late { display: none; }
    .all { display: block; width: 100%; margin-top: 4px; padding: 14px 0; border: 0; border-bottom: 1px solid var(--rule); background: none; text-align: left; font-weight: 600; color: var(--accent); cursor: pointer; }
    .col[data-open] .all { display: none; }
  }
</style>

<script>
  for (const col of document.querySelectorAll<HTMLElement>('[data-shelf]')) {
    col.querySelector('[data-all]')?.addEventListener('click', () => {
      col.toggleAttribute('data-open', true);
      col.querySelector<HTMLElement>('li.late a')?.focus();
    });
  }
</script>
