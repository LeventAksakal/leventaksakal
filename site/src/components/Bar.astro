---
import { site } from '../data/site';
interface Props { home?: boolean }
const { home = false } = Astro.props;
const to = (hash: string) => (home ? hash : `/${hash}`);
---
<header class="bar">
  <div class="who">
    <a class="name display" href="/">{site.name}</a>
    <p class="tag">
      <span>Software engineer in Istanbul</span>
      <i aria-hidden="true">/</i>
      <span class="at">MSc at <img class="seal" src="/logos/bogazici.webp" width="360" height="360" alt="" /> Boğaziçi</span>
    </p>
  </div>
  <nav aria-label="Sections">
    <a href={to('#industry')}>Industry</a>
    <a href={to('#research')}>Research</a>
    <a class="wide" href={to('#projects')}>Projects</a>
    <a class="wide" href={to('#shelf')}>Shelf</a>
    <a href="/writing/">Writing</a>
    <a class="wide" href={to('#contact')}>Contact</a>
  </nav>
</header>
