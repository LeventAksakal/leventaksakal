---
// The opening frame: the six panoramas at their own 2.11:1 ratio, one per screen, on a ground
// lit by the photograph itself. No text and no controls on the photographs: who this is sits
// in the top bar, and the arrows flank the progress ticks underneath.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Bar from './Bar.astro';
import { glow } from '../lib/glow';
import { photos, site } from '../data/site';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.jpg', { eager: true });
const slides = await Promise.all(
  photos.map(async (p) => ({
    ...p,
    src: files[`../assets/photos/${p.id}.jpg`].default,
    glow: await glow(`src/assets/photos/${p.id}.jpg`),
  })),
);
---
<div class="opening" data-hero data-auto="off">
  <div class="glow" aria-hidden="true">
    {slides.map((s, i) => <i class:list={{ on: i === 0 }} style={`background-image: url(${s.glow})`}></i>)}
  </div>

  <Bar home />
  <h1 class="sr">{site.name}. Software engineer in Istanbul, MSc student at Boğaziçi University.</h1>

  <section class="carousel" aria-roledescription="carousel" aria-label="Photographs">
    <div class="stage">
      <div class="track" data-track tabindex="0" role="group" aria-label="Slides">
        {slides.map((s, i) => (
          <div class="slide" role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}: ${s.place}, ${s.when}`} data-id={s.id} data-bg={s.bg} data-accent={s.accent} data-caption={`${s.place}, ${s.when}`}>
            <Picture
              src={s.src}
              formats={['avif', 'webp']}
              widths={[720, 1280, 1920, 2800]}
              sizes="100vw"
              alt={s.alt}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'low'}
              decoding={i === 0 ? 'sync' : 'async'}
              style={`object-position: ${s.focus}`}
            />
          </div>
        ))}
      </div>
    </div>

    <div class="reel">
      <p class="caption" data-line>{slides[0].place}, {slides[0].when}</p>
      <div class="steps">
        <button class="arrow prev" type="button" data-prev aria-label="Previous photograph">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 5 7.5 12l7 7" /></svg>
        </button>
        <div class="ticks">
          {slides.map((s, i) => (
            <button class="tick" type="button" data-tick aria-label={`Show ${s.place}`} aria-current={i === 0 ? 'true' : 'false'}><i></i></button>
          ))}
        </div>
        <button class="arrow next" type="button" data-next aria-label="Next photograph">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.5 5 7 7-7 7" /></svg>
        </button>
      </div>
      <div class="right">
        <button class="pause" type="button" data-pause aria-label="Pause the slideshow" aria-pressed="false">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path class="p1" d="M4.5 3v10M11.5 3v10" /><path class="p2" d="M5 3v10l8-5z" /></svg>
        </button>
        <span class="count" aria-hidden="true"><b data-count>1</b> / {slides.length}</span>
      </div>
    </div>
    <!-- Spoken only after the visitor changes the photograph, never while the slideshow runs. -->
    <p class="sr" role="status" data-status></p>
  </section>
</div>

<style>
  .opening { position: relative; isolation: isolate; display: grid; grid-template-rows: auto 1fr; min-height: 100svh; overflow: clip; }

  /* Ambient light: a tiny blurred copy of the photograph (see lib/glow.ts), stretched. */
  .glow { position: absolute; inset: -6% -6% 0; z-index: -1; opacity: .5; pointer-events: none; }
  .glow i { position: absolute; inset: 0; background-size: 100% 100%; opacity: 0; transition: opacity 1.2s ease; }
  .glow i.on { opacity: 1; }

  .carousel { display: grid; grid-template-rows: 1fr auto; min-width: 0; }
  .stage { align-self: center; justify-self: center; width: min(100%, calc((100svh - 158px) * 2.11)); background: #000; box-shadow: 0 40px 90px -40px rgb(0 0 0 / .9); }
  .track { display: flex; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: none; transition: opacity .22s ease; }
  .track::-webkit-scrollbar { display: none; }
  .track.cut { opacity: 0; }
  .track:focus-visible { outline-offset: -4px; }
  .slide { flex: 0 0 100%; scroll-snap-align: center; scroll-snap-stop: always; }
  .slide :global(img) { width: 100%; height: auto; aspect-ratio: 2.11; object-fit: cover; }

  .reel { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 16px; padding: 10px var(--gutter) 14px; font-size: .92rem; color: var(--soft); font-variant-numeric: tabular-nums; }
  /* One line at every width: a caption that wrapped would move the row under it whenever the
     photograph changed. */
  .caption { min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .right { display: flex; justify-content: flex-end; align-items: center; gap: 14px; }
  .count b { font-weight: 600; color: var(--text); }

  /* The arrows sit beside the ticks, off the photograph. */
  .steps { display: flex; align-items: center; gap: 12px; }
  .arrow { flex: none; display: grid; place-items: center; width: 38px; height: 38px; padding: 0; border: 1px solid color-mix(in srgb, var(--text) 28%, transparent); border-radius: 50%; background: color-mix(in srgb, var(--text) 7%, transparent); color: var(--text); cursor: pointer; touch-action: manipulation; transition: background-color .25s ease, border-color .25s ease, color .25s ease, transform .4s var(--ease); }
  .arrow svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .arrow:hover { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 14%, transparent); color: var(--accent); }
  .arrow.prev:hover { transform: translateX(-2px); }
  .arrow.next:hover { transform: translateX(2px); }
  .arrow:active { transform: scale(.94); }

  .ticks { display: flex; gap: 6px; }
  .tick { position: relative; width: clamp(24px, 3.4vw, 44px); height: 28px; padding: 0; border: 0; background: none; cursor: pointer; touch-action: manipulation; }
  .tick::before, .tick i { content: ''; position: absolute; left: 0; right: 0; top: 13px; height: 2px; border-radius: 2px; }
  /* 46% keeps the idle ticks at 3:1 against every ground, the least a control may have. */
  .tick::before { background: color-mix(in srgb, var(--text) 46%, transparent); transition: background-color .2s ease; }
  .tick:hover::before { background: color-mix(in srgb, var(--text) 75%, transparent); }
  .tick i { background: var(--accent); transform: scaleX(0); transform-origin: left; }
  .tick[aria-current='true'] i { transform: scaleX(1); }
  /* While the slideshow runs, the current tick fills up; its end is what turns the page. */
  .opening[data-auto='on'] .tick[aria-current='true'] i { animation: fill 7s linear forwards; }
  .opening:has(.stage:hover) .tick i, .opening:has(.stage:focus-within) .tick i { animation-play-state: paused; }
  @keyframes fill { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  .pause { display: grid; place-items: center; width: 28px; height: 28px; padding: 0; border: 0; border-radius: 50%; background: none; color: var(--soft); cursor: pointer; touch-action: manipulation; }
  .pause:hover { color: var(--accent); }
  .pause svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .pause .p2, .pause[aria-pressed='true'] .p1 { display: none; }
  .pause[aria-pressed='true'] .p2 { display: block; fill: currentColor; stroke: none; }

  /* Too narrow for caption, arrows and count on one line: the arrows and ticks take a row
     of their own, at a size a thumb can hit. */
  @media (max-width: 980px) {
    .stage { width: min(100%, calc((100svh - 208px) * 2.11)); }
    .reel { grid-template-columns: minmax(0, 1fr) auto; gap: 6px 16px; padding-top: 8px; }
    .steps { order: 3; grid-column: 1 / -1; }
    .ticks { flex: 1; }
    .tick { flex: 1; width: auto; }
    .arrow { width: 44px; height: 44px; }
  }
  @media (max-width: 720px) {
    .opening { min-height: 0; }
    .stage { width: 100%; }
    .slide :global(img) { aspect-ratio: 5 / 4; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pause { display: none; }
  }
  /* Windows high contrast drops background colours: draw the ticks with system colours. */
  @media (forced-colors: active) {
    .tick::before { background: CanvasText; }
    .tick i { background: Highlight; height: 4px; top: 12px; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-hero]');
  if (root) {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const slides = [...root.querySelectorAll<HTMLElement>('.slide')];
    const glows = [...root.querySelectorAll<HTMLElement>('.glow i')];
    const ticks = [...root.querySelectorAll<HTMLButtonElement>('[data-tick]')];
    const caption = root.querySelector<HTMLElement>('[data-line]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const pause = root.querySelector<HTMLButtonElement>('[data-pause]')!;
    const theme = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
    const still = matchMedia('(prefers-reduced-motion: reduce)');

    let index = 0;
    let wanted = true; // the visitor has not paused or taken over
    let visible = true;

    const sync = () => {
      root.dataset.auto = wanted && visible && !still.matches && !document.hidden ? 'on' : 'off';
      pause.setAttribute('aria-pressed', String(!wanted));
      pause.setAttribute('aria-label', wanted ? 'Pause the slideshow' : 'Play the slideshow');
    };

    const show = (i: number) => {
      index = i;
      const s = slides[i].dataset;
      document.documentElement.style.setProperty('--bg', s.bg!);
      document.documentElement.style.setProperty('--accent', s.accent!);
      theme?.setAttribute('content', s.bg!);
      try { sessionStorage.setItem('photo', s.id!); } catch {}
      glows.forEach((g, k) => g.classList.toggle('on', k === i));
      ticks.forEach((t, k) => t.setAttribute('aria-current', String(k === i)));
      caption.textContent = s.caption!;
      count.textContent = String(i + 1);
      // Announce the photograph only when the visitor is steering, not on every automatic turn.
      status.textContent = wanted ? '' : `Photograph ${i + 1} of ${slides.length}: ${s.caption}`;
      warm(i);
    };

    // The arrows do not rely on the browser's smooth scrolling (it stalls when frames are
    // scarce): the slide is driven by the clock, and a timer lands it even if no frame is drawn.
    let gliding = 0;
    let guard = 0;
    const land = (left: number) => {
      cancelAnimationFrame(gliding);
      clearTimeout(guard);
      gliding = 0;
      track.scrollLeft = left;
      track.style.scrollSnapType = '';
    };
    const glide = (left: number) => {
      land(track.scrollLeft);
      const from = track.scrollLeft;
      const t0 = performance.now();
      const ms = 520;
      track.style.scrollSnapType = 'none'; // snapping would fight every in-between position
      const tick = (now: number) => {
        const k = Math.min(1, (now - t0) / ms);
        track.scrollLeft = from + (left - from) * (1 - Math.pow(1 - k, 4));
        if (k < 1) gliding = requestAnimationFrame(tick);
        else land(left);
      };
      gliding = requestAnimationFrame(tick);
      guard = window.setTimeout(() => land(left), ms + 120);
    };

    const go = (i: number, smooth = true) => {
      const n = slides.length;
      const wrap = i < 0 || i >= n;
      const target = (i + n) % n;
      const left = target * track.clientWidth;
      if (!smooth || still.matches) {
        land(left);
      } else if (wrap) {
        // From the last photograph back to the first: cut, do not rewind through all six.
        track.classList.add('cut');
        setTimeout(() => {
          land(left);
          track.classList.remove('cut');
        }, 220);
      } else {
        glide(left);
      }
      show(target);
    };

    const takeOver = () => { wanted = false; sync(); };

    // Swipes and trackpad scrolling land here: follow the track once it settles.
    const settled = () => {
      if (gliding) return;
      const i = Math.round(track.scrollLeft / track.clientWidth);
      if (i !== index && slides[i]) show(i);
    };
    if ('onscrollend' in window) {
      track.addEventListener('scrollend', settled, { passive: true });
    } else {
      let settle = 0;
      track.addEventListener('scroll', () => { clearTimeout(settle); settle = window.setTimeout(settled, 90); }, { passive: true });
    }
    track.addEventListener('pointerdown', takeOver);
    track.addEventListener('touchstart', takeOver, { passive: true });
    track.addEventListener('wheel', (e) => { if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) takeOver(); }, { passive: true });
    track.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault();
      takeOver();
      go(index + (e.key === 'ArrowRight' ? 1 : -1));
    });

    root.querySelector('[data-prev]')!.addEventListener('click', () => { takeOver(); go(index - 1); });
    root.querySelector('[data-next]')!.addEventListener('click', () => { takeOver(); go(index + 1); });
    ticks.forEach((t, i) => t.addEventListener('click', () => { takeOver(); go(i); }));
    pause.addEventListener('click', () => { wanted = !wanted; sync(); });
    root.addEventListener('animationend', (e) => { if (e.animationName.startsWith('fill') || (e.target as HTMLElement).tagName === 'I') go(index + 1); });

    new IntersectionObserver(([entry]) => { visible = entry.intersectionRatio > 0.6; sync(); }, { threshold: [0, 0.6, 1] }).observe(root.querySelector('.stage')!);
    document.addEventListener('visibilitychange', sync);
    still.addEventListener('change', sync);

    // Keep the photograph in place when the track changes width. An observer reports after
    // layout, so nothing is measured early, and a phone's address bar sliding away (a change of
    // height only) does no work at all.
    let width = 0;
    new ResizeObserver(([entry]) => {
      const w = Math.round(entry.contentRect.width);
      if (width && w !== width) land(index * track.clientWidth);
      width = w;
    }).observe(track);

    // The other photographs are lazy. Once the page is up, fetch the two beside the one on
    // screen, so an arrow never lands on an empty frame and a phone does not pay for all six.
    let up = false;
    const eager = (n: number) => slides[(n + slides.length) % slides.length].querySelector('img')?.setAttribute('loading', 'eager');
    const warm = (i: number) => { if (up) [i, i + 1, i - 1].forEach(eager); };
    const ready = () => setTimeout(() => { up = true; warm(index); }, 600);
    if (document.readyState === 'complete') ready();
    else addEventListener('load', ready, { once: true });

    // Come back to the photograph the visitor last saw in this tab. The markup already shows
    // the first one, so nothing is touched unless another is due.
    let start = 0;
    try { start = Math.max(0, slides.findIndex((s) => s.dataset.id === sessionStorage.getItem('photo'))); } catch {}
    if (start) go(start, false);
    sync();
  }
</script>
